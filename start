#!/bin/bash
# Colors
green="\e[38;5;82m"
red="\e[38;5;196m"
neutral="\e[0m"
orange="\e[38;5;130m"
blue="\e[38;5;39m"
yellow="\e[38;5;226m"
purple="\e[38;5;141m"
bold_white="\e[1;37m"
reset="\e[0m"
pink="\e[38;5;205m"

hapus_bot_lama() {
    echo -e "${orange}Menghapus bot lama...${neutral}"
    systemctl stop sellvpn.service 2>/dev/null
    systemctl disable sellvpn.service 2>/dev/null
    rm -f /etc/systemd/system/sellvpn.service
    rm -f /usr/bin/sellvpn /usr/bin/server_sellvpn /etc/cron.d/server_sellvpn
    rm -rf /root/BotVPN2

    if command -v pm2 &> /dev/null; then
        pm2 delete sellvpn &> /dev/null
        pm2 save &> /dev/null
    fi

    systemctl daemon-reload
    echo -e "${green}Bot lama berhasil dihapus.${neutral}"
}

pasang_package() {
    echo -e "${blue}Memulai pengecekan dan instalasi dependensi...${reset}"

    # Install Node.js v20 (stabil untuk Debian 10+/Ubuntu 20+)
    if ! command -v node >/dev/null 2>&1 || ! node -v | grep -q 'v20'; then
        curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
        apt-get install -y nodejs
    fi

    # Downgrade npm ke versi 10 agar kompatibel
    npm install -g npm@10

    # Install dependencies APT
    apt update
    apt install -y build-essential libcairo2-dev libpango1.0-dev \
        libjpeg-dev libgif-dev librsvg2-dev pkg-config libpixman-1-dev git curl cron
}

setup_bot() {
    timedatectl set-timezone Asia/Jakarta

    # Clone Bot
    if [ ! -d /root/BotVPN2 ]; then
        git clone https://github.com/ajijainalganteng-wq/BotVPN2.git /root/BotVPN2
    fi

    # Install dependencies
    cd /root/BotVPN2
    mkdir -p assets
  #  rm -rf app.js
  #  rm -rf ppob.js
 #   wget imortall.web.id/botvpn/ppob.js
 #   wget imortall.web.id/botvpn/app.js
    
    cd assets
 #   wget imortall.web.id/botvpn/qris.png
 #   wget imortall.web.id/botvpn/topup_success.png
    cd 
    cd /root/BotVPN2
    npm install sqlite3 express crypto telegraf axios dotenv canvas node-fetch form-data
    npm rebuild canvas
    rm -rf node_modules
    npm install
    npm uninstall node-fetch
    npm install node-fetch@2
    npm install qrcode sharp
    chmod +x /root/BotVPN2/*
}

server_app() {
    clear

    echo -e "${orange}─────────────────────────────────────────${neutral}"
    echo -e "${green}- BOT SELLVPN TELEGRAM MOD LITE & XWAN${neutral}"
    echo -e "${orange}─────────────────────────────────────────${neutral}"

    # =====================================================
    # KONFIGURASI DASAR
    # =====================================================

    read -rp "Masukkan token bot: " token
    while [ -z "$token" ]; do
        read -rp "Masukkan token bot: " token
    done

    read -rp "Masukkan admin ID: " adminid
    while [ -z "$adminid" ]; do
        read -rp "Masukkan admin ID: " adminid
    done

    read -rp "Masukkan nama store: " namastore
    while [ -z "$namastore" ]; do
        read -rp "Masukkan nama store: " namastore
    done

    read -rp "Masukkan DATA QRIS: " dataqris
    while [ -z "$dataqris" ]; do
        read -rp "Masukkan DATA QRIS: " dataqris
    done

    read -rp "Masukkan MERCHANT ID: " merchantid
    while [ -z "$merchantid" ]; do
        read -rp "Masukkan MERCHANT ID: " merchantid
    done

    read -rp "Masukkan API KEY: " apikey
    while [ -z "$apikey" ]; do
        read -rp "Masukkan API KEY: " apikey
    done

    # =====================================================
    # TELEGRAM
    # =====================================================

    read -rp "Masukkan Chat ID Group Telegram: " chatid_group
    while [ -z "$chatid_group" ]; do
        read -rp "Masukkan Chat ID Group Telegram: " chatid_group
    done

    read -rp "Masukkan Username Saweria: " username_saweria
    while [ -z "$username_saweria" ]; do
        read -rp "Masukkan Username Saweria: " username_saweria
    done

    read -rp "Masukkan Email Saweria: " saweria_email
    while [ -z "$saweria_email" ]; do
        read -rp "Masukkan Email Saweria: " saweria_email
    done

    read -rp "Masukkan Username Grup: " username_grup
    while [ -z "$username_grup" ]; do
        read -rp "Masukkan Username Grup: " username_grup
    done

    read -rp "Masukkan Username Channel: " username_channel
    while [ -z "$username_channel" ]; do
        read -rp "Masukkan Username Channel: " username_channel
    done

    # =====================================================
    # PAYMENT LAMA
    # =====================================================

    read -rp "Masukkan Nomor WA (62xxxxx): " nomor_wa
    while [ -z "$nomor_wa" ]; do
        read -rp "Masukkan Nomor WA (62xxxxx): " nomor_wa
    done

    read -rp "Masukkan AUTH Token @orderkuota_api_bot: " authx
    while [ -z "$authx" ]; do
        read -rp "Masukkan AUTH Token: " authx
    done

    read -rp "Masukkan MERCHANT ID GOPAY: " gopay_id
    while [ -z "$gopay_id" ]; do
        read -rp "Masukkan MERCHANT ID GOPAY: " gopay_id
    done

    read -rp "Masukkan GOPAY KEY/API: " gopay_key
    while [ -z "$gopay_key" ]; do
        read -rp "Masukkan GOPAY KEY/API: " gopay_key
    done

    read -rp "Masukkan DATA QRIS GOPAY: " dataqrisgopay
    while [ -z "$dataqrisgopay" ]; do
        read -rp "Masukkan DATA QRIS GOPAY: " dataqrisgopay
    done

    # =====================================================
    # GAMBAR
    # =====================================================

    read -rp "Masukkan Link Gambar Menu: " gambar_menu
    while [ -z "$gambar_menu" ]; do
        read -rp "Masukkan Link Gambar Menu: " gambar_menu
    done

    read -rp "Masukkan Link Gambar Topup: " gambar_topup
    while [ -z "$gambar_topup" ]; do
        read -rp "Masukkan Link Gambar Topup: " gambar_topup
    done

    # =====================================================
    # PAKASIR
    # =====================================================

    read -rp "Masukkan API PAKASIR: " API_SIR
    while [ -z "$API_SIR" ]; do
        read -rp "Masukkan API PAKASIR: " API_SIR
    done

    read -rp "Masukkan NAMA PROJECT PAKASIR: " PRJ
    while [ -z "$PRJ" ]; do
        read -rp "Masukkan NAMA PROJECT PAKASIR: " PRJ
    done

    # =====================================================
    # PAYOTOMATIS
    # =====================================================

    read -rp "Masukkan API ShopeePay / PAYOTOMATIS: " SHP
    while [ -z "$SHP" ]; do
        read -rp "Masukkan API ShopeePay / PAYOTOMATIS: " SHP
    done

    # =====================================================
    # PPOB - DIGIFLAZZ
    # =====================================================

    echo
    echo -e "${purple}──── KONFIGURASI PPOB DIGIFLAZZ ────${neutral}"

    read -rp "Masukkan DIGIFLAZZ USERNAME: " digiflazz_username
    while [ -z "$digiflazz_username" ]; do
        read -rp "Masukkan DIGIFLAZZ USERNAME: " digiflazz_username
    done

    read -rsp "Masukkan DIGIFLAZZ API KEY: " digiflazz_api_key
    echo
    while [ -z "$digiflazz_api_key" ]; do
        read -rsp "Masukkan DIGIFLAZZ API KEY: " digiflazz_api_key
        echo
    done
    
    # =====================================================
    # SIMPAN .VARS.JSON
    # =====================================================

    cat > /root/BotVPN2/.vars.json <<EOF
{
  "BOT_TOKEN": "$token",
  "USER_ID": "$adminid",
  "NAMA_STORE": "$namastore",
  "PORT": "50123",

  "DATA_QRIS": "$dataqris",
  "MERCHANT_ID": "$merchantid",
  "API_KEY": "$apikey",

  "GROUP_CHAT_ID": "$chatid_group",
  "SAWERIA_USERNAME": "$username_saweria",
  "SAWERIA_EMAIL": "$saweria_email",
  "ADMIN_WA": "$nomor_wa",

  "AUTHX": "$authx",
  "GOPAY_ID": "$gopay_id",
  "GOPAY_KEY": "$gopay_key",
  "DATA_QRIS_GOPAY": "$dataqrisgopay",

  "AUTH_PAYMET_GETWAY": "AriPaymentGatewayVersion2026",

  "GROUP_USERNAME": "$username_grup",
  "CHANNEL_USERNAME": "$username_channel",

  "GAMBAR_MENU": "$gambar_menu",
  "GAMBAR_TOPUP": "$gambar_topup",

  "PAKASIR_API_KEY": "$API_SIR",
  "PAYOTOMATIS_KEY": "$SHP",
  "PAKASIR_PROJECT": "$PRJ",

  "ADMIN_IDS": "$adminid",
  "BOT_NAME": "$namastore",
  "OWNER_NAME": "",

  "TRX_CHANNEL_ID": "",
  "REQUIRED_CHANNEL_ID": "",
  "REQUIRED_CHANNEL_URL": "",

  "DIGIFLAZZ_USERNAME": "$digiflazz_username",
  "DIGIFLAZZ_API_KEY": "$digiflazz_api_key",

  "AUSTIN_BASE_URL": "https://austinstore.id",
  "AUSTIN_API_KEY": "",
  "AUSTIN_API_SECRET": "",
  "DEFAULT_ROLE": "bronze",
  "MARGIN_BRONZE": "12",
  "MARGIN_SILVER": "6",
  "MARGIN_GOLD": "3",
  "ROLE_PRICE_SILVER": "0",
  "ROLE_PRICE_GOLD": "0",
  "QRIS_EXPIRE_MINUTES": "15",
  "SYNC_INTERVAL_MINUTES": "30",
  "PAYMENT_POLL_MS": "8000",
  "TRX_POLL_MS": "30000",
  "TRX_MAX_POLLS": "40",
  "PAGE_SIZE": "8",
  "TZ": "Asia/Jakarta",
  "STORE_PHOTO": "assets/store.jpg"
}
EOF

    chmod 600 /root/BotVPN2/.vars.json

    echo
    echo -e "${green}✓ .vars.json berhasil disinkronkan dengan konfigurasi PPOB.${neutral}"

    # =====================================================
    # NODE
    # =====================================================

    NODE_PATH=$(which node)

    if [ -z "$NODE_PATH" ]; then
        echo -e "${red}Node.js tidak ditemukan.${neutral}"
        exit 1
    fi

    echo -e "${green}Node.js ditemukan di: $NODE_PATH${neutral}"

    # =====================================================
    # COMMAND SELLVPN
    # =====================================================

    cat >/usr/bin/sellvpn <<EOF
#!/bin/bash
cd /root/BotVPN2 || exit 1
$NODE_PATH app.js
EOF

    chmod +x /usr/bin/sellvpn

    # =====================================================
    # SYSTEMD
    # =====================================================

    cat >/etc/systemd/system/sellvpn.service <<EOF
[Unit]
Description=App Bot sellvpn Service
After=network.target

[Service]
ExecStart=$NODE_PATH /root/BotVPN2/app.js
WorkingDirectory=/root/BotVPN2
Restart=always
RestartSec=3
User=root
Environment=NODE_ENV=production
Environment=TZ=Asia/Jakarta
StandardOutput=append:/var/log/sellvpn.log
StandardError=append:/var/log/sellvpn-error.log
LimitNOFILE=10000

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable sellvpn
    systemctl restart sellvpn
    service cron restart

    echo
    echo -e "Status Server: $(systemctl is-active sellvpn)"
    echo -e "${green}Bot berhasil diinstal dan sedang berjalan.${neutral}"
}

if [[ $1 == "sellvpn" ]]; then
    hapus_bot_lama
    pasang_package
    setup_bot
    server_app
else
    echo -e "${red}Perintah tidak valid. Gunakan: ${yellow}start sellvpn${neutral}"
    exit 1
fi
